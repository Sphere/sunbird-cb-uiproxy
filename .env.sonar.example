# Template for local SonarQube credentials.
#
#   cp .env.sonar.example .env.sonar     # .env.sonar is git-ignored
#
# NEVER commit .env.sonar. The scripts under scripts/ source this file ONLY if
# it exists; otherwise they fall back to whatever SONAR_* variables are already
# in the environment. That is what lets the exact same command work locally and
# in CI (GitHub Actions secret / Jenkins withSonarQubeEnv) with no edits.

# --- Local SonarQube (docker-compose.sonar.yml) ---
SONAR_HOST_URL=http://localhost:9000

# Generate at: http://localhost:9000 -> My Account -> Security -> Generate Token
# A USER token is enough for `sonar:local` and `sonar:report`.
# `sonar:gate` needs a token with ADMIN rights on the project/quality gates.
SONAR_TOKEN=

# --- SonarCloud (uncomment to point the same scripts at CI's server) ---
# SONAR_HOST_URL=https://sonarcloud.io
# SONAR_TOKEN=<your sonarcloud token>
