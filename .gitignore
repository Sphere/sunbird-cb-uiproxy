/dist
/tmp
/out-tsc
# Only exists if Bazel was run
/bazel-out
/.scannerwork
/.sonarlint
# dependencies
/node_modules
.nyc_output
coverage


# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
